<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- 앱에 한국어 지역화가 등록돼 있지 않으면 스와이프 삭제 버튼이 "Delete",
	     검색창 취소가 "Cancel"처럼 시스템 기본 영어로 나온다. 앱 문구는 전부
	     한국어인데 시스템이 끼워 넣는 것만 영어여서 어색했다. -->
	<!-- 홈 화면과 설정 앱에 보이는 이름. 타깃 이름("App")이 그대로 나오고 있었다. -->
	<key>CFBundleDisplayName</key>
	<string>Mosco</string>
	<key>CFBundleDevelopmentRegion</key>
	<string>ko</string>
	<key>CFBundleLocalizations</key>
	<array>
		<string>ko</string>
	</array>
	<key>UIBackgroundModes</key>
	<array>
		<!-- CloudKit이 다른 기기의 변경을 푸시로 알려줄 때 받기 위한 것.
		     없으면 앱을 직접 열 때만 동기화된다. -->
		<string>remote-notification</string>
	</array>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>지금 계신 곳의 날씨를 캘린더에 함께 보여드리기 위해 위치를 사용합니다.</string>
	<!-- 위젯을 눌러 들어왔는지 앱이 알려면 위젯이 URL을 실어 보내야 하고,
	     그 스킴이 여기 등록돼 있어야 한다(WidgetDeepLink 참고). -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.Mosco.App</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>mosco</string>
			</array>
		</dict>
	</array>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
		<key>UISceneConfigurations</key>
		<dict>
			<key>UIWindowSceneSessionRoleApplication</key>
			<array>
				<dict>
					<key>UISceneConfigurationName</key>
					<string>Default Configuration</string>
					<key>UISceneDelegateClassName</key>
					<string>$(PRODUCT_MODULE_NAME).SceneDelegate</string>
				</dict>
			</array>
		</dict>
	</dict>
</dict>
</plist>

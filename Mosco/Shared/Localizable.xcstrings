    "고른 색이 밝아서 글자가 안 보일까 봐 조금 어둡게 했어요.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That color is quite bright, so we darkened it a little to keep text readable."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選んだ色が明るいため、文字が見えるよう少し暗くしました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "고른 색이 밝아서 글자가 안 보일까 봐 조금 어둡게 했어요."
          }
        }
      }
    },
    "곧 시작해요": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {

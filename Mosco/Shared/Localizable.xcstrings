    "8시간 안에 시작하는 할 일만 띄울 수 있어요": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only to-dos starting within 8 hours can be shown"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "8時間以内に始まるやることだけ表示できます"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "8시간 안에 시작하는 할 일만 띄울 수 있어요"
          }
        }
      }
    },
    "Mosco를 찾아 '오늘 할 일'을 고르세요": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Find Mosco and choose Today's To-Dos"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Moscoを探して「今日のやること」を選択"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Mosco를 찾아 '오늘 할 일'을 고르세요"
          }
        }
      }
    },
    "iCloud 동기화": {
      "extractionState": "manual",

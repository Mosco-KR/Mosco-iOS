    "할 일, 카테고리, 캘린더가 모두 사라져요.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All to-dos, categories, and calendars will be removed."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "やること、カテゴリ、カレンダーがすべて消えます。"
          }
        },

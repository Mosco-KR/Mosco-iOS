    "날짜를 정하지 않으면 '언젠가 할 일'에 담겨요.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Without a date, it goes to your No Date list."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "日付を決めないと「日付未定」に入ります。"
